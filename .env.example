# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# The site's address
PRIMARY_SITE_URL=http://social-images-craft-demo.test

# Database (DDEV sets these itself)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=social_images_craft_demo
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=

# Social Images renders with Browsershot: point it at Node, npm, Chrome and
# a node_modules with puppeteer (npm install puppeteer). Or use Cloudflare:
# SOCIAL_IMAGES_RENDERER=cloudflare, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
SOCIAL_IMAGES_NODE_BINARY=/usr/local/bin/node
SOCIAL_IMAGES_NPM_BINARY=/usr/local/bin/npm
SOCIAL_IMAGES_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
SOCIAL_IMAGES_NODE_MODULES_PATH=
