{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "craftcms/cms": "^5.9.0",
    "vlucas/phpdotenv": "^5.4.0",
    "1994/social-images-craft": "^1.0",
    "spatie/browsershot": "^5.0",
    "nystudio107/craft-seomatic": "^5.1"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  },
  "name": "1994/social-images-craft-demo",
  "description": "Dog-ear Books: a demo site for Social Images for Craft.",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "modules\\demo\\": "modules/demo/"
    }
  }
}
