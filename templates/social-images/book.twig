{#
    A code template: the book's cover beside its title, on a dark ground.
    Fonts and pictures are inlined by craft.socialImages.font() and
    craft.socialImages.embed(), so the page loads nothing over the network.
#}
{% set cover = entry ? entry.coverImage.one() : null %}
<!doctype html>
<html lang="{{ currentSite.language }}">
<head>
<meta charset="utf-8">
<style>
    {{ craft.socialImages.font('Fraunces', 600) }}
    {{ craft.socialImages.font('Inter', 500) }}
    body { margin: 0; width: {{ socialLayout.width }}px; height: {{ socialLayout.height }}px; background: #1f1a14; color: #f6f1e7; font-family: Inter, sans-serif; }
    .card { display: flex; gap: 64px; align-items: center; height: 100%; padding: 0 80px; box-sizing: border-box; }
    .cover { width: 320px; height: 480px; object-fit: cover; border-radius: 6px; box-shadow: 0 30px 60px rgb(0 0 0 / 0.5); transform: rotate(-3deg); }
    .text { flex: 1; height: 420px; display: flex; flex-direction: column; justify-content: center; }
    h1 { font-family: Fraunces, serif; font-weight: 600; line-height: 1.05; margin: 0 0 24px; }
    p { margin: 0; font-size: 28px; opacity: 0.8; }
</style>
</head>
<body>
    <div class="card">
        {% if cover %}<img class="cover" src="{{ craft.socialImages.embed(cover, 320, 480) }}" alt="">{% endif %}
        <div class="text">
            <h1 data-fit="88" data-fit-min="40" data-fit-lines="3">{{ entry.title ?? sample.title }}</h1>
            <p>{{ entry.byline ?? 'An author' }}{% if entry.price ?? false %} · £{{ entry.price }}{% endif %}</p>
        </div>
    </div>
</body>
</html>
